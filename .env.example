# Copy to .env.local for development, and add the same variables in your hosting provider.

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK — from Firebase console → Project settings → Service accounts → Generate new private key.
# Copy project_id, client_email and private_key from the downloaded JSON. Keep the quotes around the key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
