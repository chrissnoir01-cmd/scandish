{
  "id": "/dashboard",
  "name": "ScanDish Business",
  "short_name": "ScanDish",
  "description": "Manage your ScanDish menu page and track table orders.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fff8f5",
  "theme_color": "#f08c6c",
  "categories": ["business", "food"],
  "icons": [
    { "src": "/app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Track order", "url": "/dashboard?tab=orders", "icons": [{ "src": "/app/icon-192.png", "sizes": "192x192" }] }
  ]
}
