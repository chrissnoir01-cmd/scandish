rules_version = '2';

// All data access goes through the Next.js server (Firebase Admin SDK),
// which bypasses these rules and checks permissions in code.
// Browsers only use Firebase Authentication, so they get no direct database access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
