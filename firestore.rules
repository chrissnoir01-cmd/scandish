rules_version = '2';

// All data access goes through the Next.js server (Firebase Admin SDK),
// which bypasses these rules and checks permissions in code.
// Browsers only use Firebase Authentication, so they get no direct database access —
// with one exception: a restaurant owner may read (never write) their own table orders,
// so new orders appear on the dashboard the moment they are placed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /restaurants/{restaurantId}/orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == restaurantId;
    }
  }
}
